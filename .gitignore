# Built binaries — build into bin/, never commit them to the repo root.
bin/
/generate-factions-kb
/analyze-empire-economy
/seed-overlays

# local backup archives (portraits etc.) — never commit
*.tar

# temporary local portrait review contact-sheets — never commit
portrait-gallery.html
agent-portrait-gallery.html

# Voidborn species concept exploration — local review artifact (PNGs + generated
# gallery + prompt data). The build script in tools/ IS tracked.
voidborn-concepts/

# Python bytecode caches (tools/ scripts)
__pycache__/
*.pyc

# superpowers skill framework working state (not KB content)
.superpowers/

# Overlay-sourced images under kb/ are copies of the single committed source in
# overlays/ (generated portraits + contributor overlay images). Don't commit the
# duplicates: the generator writes them locally for preview, and the deploy
# injects them from overlays/ via scripts/inject-overlay-images.sh before
# publishing. Item/ship/system/planet images live elsewhere and stay tracked.
kb/passengers/**/*.png
kb/passengers/**/*.jpg
kb/passengers/**/*.jpeg
kb/passengers/**/*.webp
kb/passengers/**/*.gif
kb/players/**/*.png
kb/players/**/*.jpg
kb/players/**/*.jpeg
kb/players/**/*.webp
kb/players/**/*.gif
kb/factions/**/*.png
kb/factions/**/*.jpg
kb/factions/**/*.jpeg
kb/factions/**/*.webp
kb/factions/**/*.gif

# Footprint recovery: regenerable per-ship intermediates. profile.json (and
# the batch report.json) are the only artifacts committed (see
# tools/footprint/README.md).
data/footprints/*/*.npz
data/footprints/*/matte.png
data/footprints/*/camera.json
data/footprints/*/quality.json
data/footprints/*/footprint.json
data/footprints/*/keyability.json

# The footprint SVG bundle is derived from the committed
# data/footprints/<id>_{top,side,front}.svg files, so it is not stored. The
# deploy workflow rebuilds it into kb/ via scripts/build-footprint-zip.sh,
# the same pattern as the gitignored kb/ portrait copies under overlays/.
data/footprints/ship_footprint_svg.zip
kb/ships/blueprints/ship_footprint_svg.zip

# Blueprint hero vignettes (kb/ships/blueprints/art/) are COMMITTED as
# 128-color palette PNGs so they show on the live site; they regenerate
# byte-stable from the chromakeys drop via make_blueprints.py.

# Plan silhouettes the fitting sheet fetches on demand; restored from the
# committed data/footprints/<id>_top.svg by scripts/build-fitting-plans.sh.
kb/ships/plans/

# Site search index — derived from the generated pages, rebuilt at deploy time
# by scripts/build-search-index.sh.
kb/search-index.json
