{{template "head" .}}
<style>
    #hull-table th[data-type] { cursor: pointer; user-select: none; }
    #hull-table td.n, #hull-table th.n { text-align: right; }
    #hull-table details > .pc-table { margin-left: 0; }
</style>
<h1>Hull Costs <small>private</small></h1>
<p class="note"><a href="index.html">Production costs</a> · Local only, never published. Making each hull from its build materials versus buying the materials or a listed hull. Make total = materials + royalty + labor. A "≥" marks a floor (salvage, unpriced or cyclic inputs count as 0); "?" is unknown labor. Boxed = making beats the market. Click a column to sort; expand a hull for its materials.</p>
<div class="scrollx">
<table class="pc-table" id="hull-table">
<thead><tr><th data-type="text">Hull</th><th data-type="num" class="n">Tier</th><th data-type="text">Empire</th><th data-type="num" class="n">Cargo</th><th data-type="num" class="n">Materials</th><th data-type="num" class="n">Labor</th><th data-type="num" class="n">Royalty</th><th data-type="num" class="n">Make total</th><th data-type="text">License</th><th data-type="num" class="n">Materials at market</th><th data-type="num" class="n">Cheapest listing</th><th data-type="text">Flags</th></tr></thead>
<tbody>
{{range .Hulls}}<tr data-hull="{{.ID}}"{{if .Partial}} class="pc-partial"{{end}}>
<td data-sort="{{.Name}}"><details><summary>{{.Name}} <span class="note">{{.Class}}</span></summary>
<table class="pc-table"><thead><tr><th>Material</th><th>Qty</th><th>Route</th><th>Cost/u</th><th>Total</th><th>Flags</th><th>Ask</th></tr></thead><tbody>
{{range .Mats}}<tr><td><a href="{{.Href}}">{{.Name}}</a></td><td>{{.Qty}}</td><td>{{.Route}}</td><td>{{.Unit}}</td><td>{{.Total}}</td><td>{{.Flags}}</td><td>{{.Ask}}</td></tr>
{{end}}</tbody></table></details></td>
<td class="n" data-sort="{{.Tier}}">{{.Tier}}</td>
<td data-sort="{{.Empire}}">{{.Empire}}</td>
<td class="n" data-sort="{{.Cargo}}">{{.Cargo}}</td>
<td class="n" data-sort="{{.MaterialsSort}}">{{.Materials}}</td>
<td class="n" data-sort="{{.LaborSort}}">{{if .LaborNote}}<span title="{{.LaborNote}}">{{.Labor}}</span>{{else}}{{.Labor}}{{end}}</td>
<td class="n" data-sort="{{.Royalty}}">{{.Royalty}}{{if .RoyaltyNote}} <span class="note">{{.RoyaltyNote}}</span>{{end}}</td>
{{if .Best}}<td class="n hl-cheap" data-sort="{{.TotalSort}}">{{else}}<td class="n" data-sort="{{.TotalSort}}">{{end}}{{.Total}}</td>
<td data-sort="{{.License}}">{{.License}}</td>
<td class="n" data-sort="{{.MarketSort}}">{{.Market}}</td>
<td class="n" data-sort="{{.ListingSort}}">{{.Listing}}</td>
<td data-sort="{{.FlagsText}}">{{.FlagsText}}</td>
</tr>
{{end}}</tbody>
</table>
</div>
<script>
(function() {
    var table = document.getElementById('hull-table');
    var body = table.tBodies[0];
    var last = -1, dir = 1;
    table.tHead.rows[0].querySelectorAll('th').forEach(function(th, i) {
        th.addEventListener('click', function() {
            dir = (last === i) ? -dir : 1; last = i;
            var num = th.getAttribute('data-type') === 'num';
            var rows = Array.prototype.slice.call(body.rows);
            rows.sort(function(a, b) {
                var x = a.cells[i].getAttribute('data-sort'), y = b.cells[i].getAttribute('data-sort');
                if (num) return dir * (parseFloat(x) - parseFloat(y));
                return dir * x.localeCompare(y);
            });
            rows.forEach(function(r) { body.appendChild(r); });
        });
    });
})();
</script>
{{template "foot" .}}
